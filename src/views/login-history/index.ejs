<%- include('../layout', { title: '登入紀錄', body: `
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2><i class="bi bi-box-arrow-in-right"></i> 登入紀錄</h2>
</div>

<!-- 篩選表單 -->
<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/login-history" class="row g-3">
      <div class="col-md-4">
        <label class="form-label">使用者</label>
        <select name="user_id" class="form-select">
          <option value="">全部</option>
          ${users.map(u => `
            <option value="${u.id}" ${filters.userId === u.id ? 'selected' : ''}>${u.name_html}（${u.username_html}）</option>
          `).join('')}
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">開始日期</label>
        <input type="date" name="start_date" class="form-control" value="${filters.startDate || ''}">
      </div>
      <div class="col-md-3">
        <label class="form-label">結束日期</label>
        <input type="date" name="end_date" class="form-control" value="${filters.endDate || ''}">
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">
          <i class="bi bi-search"></i> 搜尋
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 紀錄列表 -->
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span>共 ${pagination.total} 筆記錄</span>
    <div>
      ${pagination.page > 1 ? `
        <a href="?${queryString ? queryString + '&' : ''}page=${pagination.page - 1}" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-chevron-left"></i> 上一頁
        </a>
      ` : ''}
      <span class="mx-2">第 ${pagination.page} / ${pagination.totalPages} 頁</span>
      ${pagination.page < pagination.totalPages ? `
        <a href="?${queryString ? queryString + '&' : ''}page=${pagination.page + 1}" class="btn btn-sm btn-outline-primary">
          下一頁 <i class="bi bi-chevron-right"></i>
        </a>
      ` : ''}
    </div>
  </div>
  <div class="card-body p-0">
    ${records.length === 0 ? `
      <div class="text-center py-5">
        <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
        <p class="text-muted mt-3">尚無登入紀錄</p>
      </div>
    ` : `
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>登入時間</th>
              <th>使用者</th>
              <th>帳號</th>
              <th>IP 位址</th>
              <th>地區</th>
              <th>瀏覽器/裝置資訊</th>
            </tr>
          </thead>
          <tbody>
            ${records.map(r => `
              <tr>
                <td>${r.logged_in_at}</td>
                <td>${r.name_html || '-'}</td>
                <td>${r.username_html || '-'}</td>
                <td>${r.ip_address_html}</td>
                <td>${r.country_display}</td>
                <td class="text-break">${r.user_agent_html}</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
      </div>
    `}
  </div>
</div>
` }) %>
