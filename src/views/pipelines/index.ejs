<%
  const WIN_PROBABILITY_STAGE_LABELS = typeof winProbabilityStageLabels !== 'undefined' ? winProbabilityStageLabels : {};
  const localPipelineStatuses = typeof pipelineStatuses !== 'undefined' && pipelineStatuses ? pipelineStatuses : [];
  const localStatusColorMap = typeof pipelineStatusColorMap !== 'undefined' && pipelineStatusColorMap ? pipelineStatusColorMap : {};
  // 卡片圖示依贏單/輸單旗標決定，沒有對應設定的狀態（含尚未設定 pipeline_statuses 時）一律用預設現金圖示
  function statusIcon(statusName) {
    const s = localPipelineStatuses.find(x => x.status_name === statusName);
    if (s && s.is_won) return 'bi-check-circle';
    if (s && s.is_lost) return 'bi-x-circle';
    return 'bi-hourglass-split';
  }
  // 商機名稱、客戶/業務姓名皆為自由文字欄位，輸出前需跳脫，避免儲存型 XSS
  function escapeHtml(str) {
    return (str || '').toString().replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
%>
<%- include('../layout', { body: `
<div class="row mb-4">
  <div class="col">
    <h1 class="h3"><i class="bi bi-bullseye"></i> 銷售機會管理</h1>
  </div>
  <div class="col-auto">
    ${locals.canEditCrm ? '<a href="/pipelines/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> 新增銷售機會</a>' : ''}
  </div>
</div>

${error ? `
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle"></i> ${escapeHtml(error)}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
` : ''}

<div class="mb-3">
  <div class="btn-group" role="group">
    <a href="/pipelines" class="btn btn-sm ${!statusFilter ? 'btn-primary' : 'btn-outline-primary'}">全部</a>
    ${localPipelineStatuses.map(s => {
      const color = localStatusColorMap[s.status_name] || 'secondary';
      const active = statusFilter === s.status_name;
      return '<a href="/pipelines?status=' + encodeURIComponent(s.status_name) + '" class="btn btn-sm ' + (active ? 'btn-' + color : 'btn-outline-' + color) + '">' + escapeHtml(s.status_name) + '</a>';
    }).join('')}
  </div>
  <small class="text-muted ms-2">以下統計數字皆依目前篩選條件計算</small>
</div>

<div class="row g-3 mb-3">
  ${(summary.byStatus || []).map(g => `
    <div class="col-md-4">
      <div class="card h-100 bg-${localStatusColorMap[g.status] || 'primary'} text-white">
        <div class="card-body text-center">
          <h6 class="mb-1"><i class="bi ${statusIcon(g.status)}"></i> ${escapeHtml(g.status)}預估金額</h6>
          <h3 class="mb-0">${typeof currencySymbol !== 'undefined' ? currencySymbol : '$'}${(g.amount || 0).toLocaleString()}</h3>
          <small>共 ${g.count || 0} 筆</small>
        </div>
      </div>
    </div>
  `).join('')}
</div>

<div class="row g-3 mb-3">
  <div class="col-12">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-percent"></i> 依成交機率加總</div>
      <div class="card-body">
        <div class="row g-2 text-center">
          ${(summary.byProbability || []).map(g => `
            <div class="col">
              <div class="border rounded p-2 h-100">
                <div class="small text-muted">${g.label ? g.label + ' ' : ''}${g.pct !== null ? g.pct + '%' : ''}</div>
                <div class="fw-bold">${typeof currencySymbol !== 'undefined' ? currencySymbol : '$'}${(g.amount || 0).toLocaleString()}</div>
                <div class="small text-muted">${g.count || 0} 筆</div>
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-calendar-range"></i> 依預計成交月份加總</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>預計成交月份</th>
                <th class="text-center">筆數</th>
                <th class="text-end">預估金額</th>
              </tr>
            </thead>
            <tbody>
              ${(summary.byMonth || []).length === 0 ? '<tr><td colspan="3" class="text-center text-muted py-3">尚無資料</td></tr>' : (summary.byMonth || []).map(g => `
                <tr>
                  <td>${escapeHtml(g.month)}</td>
                  <td class="text-center">${g.count || 0}</td>
                  <td class="text-end">${typeof currencySymbol !== 'undefined' ? currencySymbol : '$'}${(g.amount || 0).toLocaleString()}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-person-badge"></i> 依業務分類加總</div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>業務</th>
                <th class="text-center">筆數</th>
                <th class="text-end">預估金額</th>
              </tr>
            </thead>
            <tbody>
              ${(summary.bySalesperson || []).length === 0 ? '<tr><td colspan="3" class="text-center text-muted py-3">尚無資料</td></tr>' : (summary.bySalesperson || []).map(g => `
                <tr>
                  <td>${escapeHtml(g.salesperson)}</td>
                  <td class="text-center">${g.count || 0}</td>
                  <td class="text-end">${typeof currencySymbol !== 'undefined' ? currencySymbol : '$'}${(g.amount || 0).toLocaleString()}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>
              <a href="?${(sortLinks && sortLinks.created_at) || ''}" class="text-dark text-decoration-none">
                建立日期${(sortIcons && sortIcons.created_at) || ''}
              </a>
            </th>
            <th>
              <a href="?${(sortLinks && sortLinks.updated_at) || ''}" class="text-dark text-decoration-none">
                最後更新日期${(sortIcons && sortIcons.updated_at) || ''}
              </a>
            </th>
            <th>
              <a href="?${(sortLinks && sortLinks.opportunity_name) || ''}" class="text-dark text-decoration-none">
                銷售機會${(sortIcons && sortIcons.opportunity_name) || ''}
              </a>
            </th>
            <th>
              <a href="?${(sortLinks && sortLinks.customer_name) || ''}" class="text-dark text-decoration-none">
                客戶${(sortIcons && sortIcons.customer_name) || ''}
              </a>
            </th>
            <th>
              <a href="?${(sortLinks && sortLinks.salesperson_name) || ''}" class="text-dark text-decoration-none">
                業務${(sortIcons && sortIcons.salesperson_name) || ''}
              </a>
            </th>
            <th class="text-end">
              <a href="?${(sortLinks && sortLinks.estimated_amount) || ''}" class="text-dark text-decoration-none">
                預估金額${(sortIcons && sortIcons.estimated_amount) || ''}
              </a>
            </th>
            <th>
              <a href="?${(sortLinks && sortLinks.win_probability) || ''}" class="text-dark text-decoration-none">
                成交機率${(sortIcons && sortIcons.win_probability) || ''}
              </a>
            </th>
            <th>
              <a href="?${(sortLinks && sortLinks.expected_close_year_month) || ''}" class="text-dark text-decoration-none">
                預計成交月份${(sortIcons && sortIcons.expected_close_year_month) || ''}
              </a>
            </th>
            <th>
              <a href="?${(sortLinks && sortLinks.status) || ''}" class="text-dark text-decoration-none">
                狀態${(sortIcons && sortIcons.status) || ''}
              </a>
            </th>
          </tr>
        </thead>
        <tbody>
          ${pipelines.map(p => `
            <tr onclick="location.href='/pipelines/${p.id}'" style="cursor:pointer">
              <td>${(p.created_at || '').slice(0, 10) || '-'}</td>
              <td>${(p.updated_at || '').slice(0, 10) || '-'}</td>
              <td>${escapeHtml(p.opportunity_name)}</td>
              <td>${escapeHtml(p.customer_name) || '-'}</td>
              <td>${escapeHtml(p.salesperson_name) || '-'}</td>
              <td class="text-end">${typeof currencySymbol !== 'undefined' ? currencySymbol : '$'}${(p.estimated_amount || 0).toLocaleString()}</td>
              <td>${p.win_probability !== null && p.win_probability !== undefined ? (WIN_PROBABILITY_STAGE_LABELS[p.win_probability] ? WIN_PROBABILITY_STAGE_LABELS[p.win_probability] + ' ' : '') + p.win_probability + '%' : '-'}</td>
              <td>${p.expected_close_year_month || '-'}</td>
              <td>
                <span class="badge bg-${localStatusColorMap[p.status] || 'warning'}">${escapeHtml(p.status)}</span>
                ${p.converted_project_id ? '<span class="badge bg-info ms-1">已轉入專案</span>' : ''}
              </td>
            </tr>
          `).join('') || '<tr><td colspan="9" class="text-center text-muted py-3">尚無銷售機會</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>
` }) %>
