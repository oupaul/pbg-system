<%
  function escapeHtml(str) {
    return (str || '').toString().replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
%>
<%- include('../layout', { body: `
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2><i class="bi bi-award"></i> 獎金類型管理</h2>
  <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTypeModal">
    <i class="bi bi-plus-circle"></i> 新增類型
  </button>
</div>

${error ? `
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-circle"></i> ${escapeHtml(error)}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
` : ''}

${success ? `
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle"></i> ${escapeHtml(success)}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
` : ''}

<div class="alert alert-info">
  <i class="bi bi-info-circle"></i> 這裡設定的是專案詳情頁「新增獎金」表單裡的獎金類型選項。停用或刪除類型前，系統會先檢查是否有獎金記錄仍在使用該類型。
</div>

<div class="card">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0"><i class="bi bi-list-ul"></i> 獎金類型列表</h5>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 80px;">排序</th>
            <th>類型名稱</th>
            <th>狀態</th>
            <th style="width: 200px;">操作</th>
          </tr>
        </thead>
        <tbody>
          ${types.map(t => `
            <tr>
              <td>${t.display_order}</td>
              <td>${escapeHtml(t.type_name)}</td>
              <td>${t.is_active === 1 ? '<span class="badge bg-success">啟用</span>' : '<span class="badge bg-secondary">停用</span>'}</td>
              <td>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="editType(${t.id}, '${escapeHtml(t.type_name).replace(/'/g, "\\'")}', ${t.display_order}, ${t.is_active})">
                  <i class="bi bi-pencil"></i> 編輯
                </button>
                <form action="/bonus-types/delete/${t.id}" method="POST" style="display:inline" onsubmit="return confirm('確定要刪除此獎金類型？\\n\\n注意：如果有獎金記錄使用此類型，將無法刪除。')">
                  <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash"></i> 刪除
                  </button>
                </form>
              </td>
            </tr>
          `).join('') || '<tr><td colspan="4" class="text-center text-muted py-3">尚無獎金類型，請點擊「新增類型」新增</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade" id="addTypeModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/bonus-types/create">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-circle"></i> 新增獎金類型</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">類型名稱 <span class="text-danger">*</span></label>
            <input type="text" name="type_name" class="form-control" required maxlength="50">
          </div>
          <div class="mb-3">
            <label class="form-label">顯示順序</label>
            <input type="number" name="display_order" class="form-control" min="0">
            <small class="form-text text-muted">數字越小越靠前，留空則排在最後</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
          <button type="submit" class="btn btn-primary">新增</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="editTypeModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/bonus-types/update/" id="editTypeForm">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil"></i> 編輯獎金類型</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">類型名稱 <span class="text-danger">*</span></label>
            <input type="text" name="type_name" id="editTypeName" class="form-control" required maxlength="50">
          </div>
          <div class="mb-3">
            <label class="form-label">顯示順序</label>
            <input type="number" name="display_order" id="editTypeOrder" class="form-control" min="0">
          </div>
          <div class="mb-3">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="is_active" id="editTypeActive" value="1">
              <label class="form-check-label" for="editTypeActive">啟用</label>
            </div>
            <small class="form-text text-muted">停用的類型將不會出現在新增獎金的下拉選單中，但已存在的獎金記錄不受影響</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
          <button type="submit" class="btn btn-primary">儲存</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function editType(id, name, order, isActive) {
  document.getElementById('editTypeForm').action = '/bonus-types/update/' + id;
  document.getElementById('editTypeName').value = name;
  document.getElementById('editTypeOrder').value = order;
  document.getElementById('editTypeActive').checked = isActive === 1;
  new bootstrap.Modal(document.getElementById('editTypeModal')).show();
}
</script>
` }) %>
