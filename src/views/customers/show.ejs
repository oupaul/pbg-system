<%
  // 公司名稱、客戶編號、商機名稱皆為自由文字欄位，輸出前需跳脫，避免儲存型 XSS
  function escapeHtml(str) {
    return (str || '').toString().replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
%>
<%- include('../layout', { body: `
<div class="row mb-4">
  <div class="col">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/customers">客戶與廠商管理</a></li>
        <li class="breadcrumb-item active">${escapeHtml(customer.company_name)}</li>
      </ol>
    </nav>
    <h1 class="h3 mt-2">
      ${escapeHtml(customer.company_name)}
      <span class="badge bg-${customer.party_type === '廠商' ? 'dark' : customer.party_type === '兩者皆是' ? 'primary' : 'info'} align-middle">${customer.party_type || '客戶'}</span>
      ${customer.vendor_type ? '<span class="badge bg-secondary align-middle">' + escapeHtml(customer.vendor_type) + '</span>' : ''}
      ${customer.customer_level ? '<span class="badge bg-' + ((typeof customerLevelColorMap !== 'undefined' && customerLevelColorMap[customer.customer_level]) || 'secondary') + ' align-middle">' + escapeHtml(customer.customer_level) + '級</span>' : ''}
      <span class="badge bg-${(typeof customerStatusColorMap !== 'undefined' && customerStatusColorMap[customer.status]) || 'secondary'} align-middle">${escapeHtml(customer.status || '往來中')}</span>
    </h1>
    ${customer.industry ? '<p class="text-muted mb-0"><i class="bi bi-building"></i> ' + customer.industry.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>' : ''}
  </div>
</div>

${error ? `
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle"></i> ${escapeHtml(error)}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
` : ''}

${success ? `
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle"></i> ${escapeHtml(success)}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
` : ''}

<div class="row g-4 mb-4">
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h6 class="text-muted">客戶編號</h6>
        <p class="fs-5 mb-0"><code>${escapeHtml(customer.customer_code)}</code></p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h6 class="text-muted">統一編號</h6>
        <p class="fs-5 mb-0">${customer.tax_id || '-'}</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h6 class="text-muted"><i class="bi bi-person-badge"></i> 客戶關係負責人（使用者）</h6>
        <p class="fs-5 mb-0">${customer.owner_salesperson_name || '-'}</p>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body">
        <h6 class="text-muted"><i class="bi bi-person-lines-fill"></i> 客戶聯絡窗口（對方）</h6>
        <p class="fs-5 mb-0">${customer.contact_name || '-'}</p>
        <p class="text-muted small mb-0">${customer.contact_phone || ''}${customer.contact_phone && customer.contact_email ? ' · ' : ''}${customer.contact_email || ''}</p>
      </div>
    </div>
  </div>
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <h6 class="text-muted"><i class="bi bi-geo-alt"></i> 地址</h6>
        <p class="fs-5 mb-0">${(customer.address || '-').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>
      </div>
    </div>
  </div>
  <div class="col-12">
    <div class="card bg-primary text-white">
      <div class="card-body text-center">
        <h6>專案數 / 總金額</h6>
        <h4>${stats?.project_count || 0} 件 / $${(stats?.total_amount || 0).toLocaleString()}</h4>
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-folder"></i> 專案列表</div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>專案編號</th>
            <th>專案名稱</th>
            <th>類型</th>
            <th>業務</th>
            <th class="text-end">金額</th>
            <th>狀態</th>
          </tr>
        </thead>
        <tbody>
          ${projects.map(p => `
            <tr ${p._locked ? '' : `onclick="location.href='/projects/${p.id}'" style="cursor:pointer"`}>
              <td><code>${p.project_code}</code>${p._locked ? ' <i class="bi bi-lock-fill text-muted" title="無權限查看此專案"></i>' : ''}</td>
              <td>${p.project_name}</td>
              <td><span class="badge bg-${p.project_type === '食驗室' ? 'primary' : p.project_type === '純廣' ? 'success' : 'info'}">${p.project_type}</span></td>
              <td>${p.salesperson_name || '-'}</td>
              <td class="text-end">${p._locked ? '<span class="text-muted">-</span>' : '$' + (p.price_with_tax || 0).toLocaleString()}</td>
              <td><span class="badge bg-${p.status === '已結案' ? 'secondary' : 'warning'}">${p.status}</span></td>
            </tr>
          `).join('') || '<tr><td colspan="6" class="text-center text-muted py-3">尚無專案</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-bullseye"></i> 銷售機會</span>
    ${locals.canEditCrm ? '<a href="/pipelines/new?customer_id=' + customer.id + '" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> 新增銷售機會</a>' : ''}
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>銷售機會</th>
            <th>業務</th>
            <th class="text-end">預估金額</th>
            <th>預計成交月份</th>
            <th>狀態</th>
          </tr>
        </thead>
        <tbody>
          ${pipelines.map(p => `
            <tr onclick="location.href='/pipelines/${p.id}'" style="cursor:pointer">
              <td>${escapeHtml(p.opportunity_name)}</td>
              <td>${escapeHtml(p.salesperson_name) || '-'}</td>
              <td class="text-end">$${(p.estimated_amount || 0).toLocaleString()}</td>
              <td>${p.expected_close_year_month || '-'}</td>
              <td><span class="badge bg-${(typeof pipelineStatusColorMap !== 'undefined' && pipelineStatusColorMap[p.status]) || 'warning'}">${escapeHtml(p.status)}</span></td>
            </tr>
          `).join('') || '<tr><td colspan="5" class="text-center text-muted py-3">尚無銷售機會</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-gift"></i> 轉介紹紀錄</span>
    ${locals.canEditCrm ? '<button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addReferralModal"><i class="bi bi-plus-lg"></i> 新增轉介紹</button>' : ''}
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>被介紹客戶</th>
            <th>對應專案</th>
            <th>受益對象</th>
            <th class="text-end">獎勵金額</th>
            <th>狀態</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          ${(referralRewards || []).map(r => {
            const recipientLabel = r.recipient_type === 'staff'
              ? escapeHtml(r.recipient_user_name || '-') + ' <span class="badge bg-info">員工</span>'
              : escapeHtml(customer.company_name) + ' <span class="badge bg-secondary">客戶本人</span>';
            const statusBadge = r.status === '已發放' ? 'success' : r.status === '充公' ? 'danger' : 'warning';
            const deleteControl = !locals.canEditCrm ? '' : `<form action="/referral-rewards/${r.id}/delete" method="POST" style="display:inline" onsubmit="return confirm('確定要刪除此轉介紹紀錄？')">
              <input type="hidden" name="redirect" value="/customers/${customer.id}">
              <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="刪除"><i class="bi bi-trash"></i></button>
            </form>`;
            return `
            <tr>
              <td>${r.referred_customer_name ? escapeHtml(r.referred_customer_name) : '<span class="text-muted">-</span>'}</td>
              <td>${r.project_code ? escapeHtml(r.project_code) : '<span class="text-muted">-</span>'}</td>
              <td>${recipientLabel}</td>
              <td class="text-end">$${(r.reward_amount || 0).toLocaleString()}</td>
              <td><span class="badge bg-${statusBadge}">${r.status}</span></td>
              <td class="text-end">
                ${locals.canEditCrm ? '<button type="button" class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal" data-bs-target="#editReferralModal' + r.id + '"><i class="bi bi-pencil"></i></button>' : ''}
                ${deleteControl}
              </td>
            </tr>
          `;
          }).join('') || '<tr><td colspan="6" class="text-center text-muted py-3">尚無轉介紹紀錄</td></tr>'}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-clock-history"></i> 活動紀錄</div>
  <div class="card-body">
    ${locals.canEditCrm ? `
      <form action="/customers/${customer.id}/activities" method="POST" class="row g-2 mb-4">
        <div class="col-md-2">
          <select name="activity_type" class="form-select">
            ${(typeof activityTypes !== 'undefined' && activityTypes ? activityTypes : []).map(t => {
              const safeName = escapeHtml(t.type_name).replace(/"/g, '&quot;');
              return '<option value="' + safeName + '">' + escapeHtml(t.type_name) + '</option>';
            }).join('')}
          </select>
        </div>
        <div class="col-md-7">
          <input type="text" name="content" class="form-control" placeholder="記錄本次拜訪、通話或客訴的內容..." required>
        </div>
        <div class="col-md-2">
          <input type="date" name="activity_date" class="form-control">
        </div>
        <div class="col-md-1">
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg"></i></button>
        </div>
      </form>
    ` : ''}

    <ul class="list-group list-group-flush">
      ${activities.map(a => {
        const isPending = (pendingActivityDeletionIds || []).includes(a.id);
        const deleteControl = !locals.canEditCrm ? '' : isPending
          ? '<span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> 審核中</span>'
          : `<form action="/customers/${customer.id}/activities/${a.id}/delete" method="POST" onsubmit="return confirm('${locals.canDelete ? '確定要刪除此活動紀錄？' : '確定要送出刪除申請嗎？將由管理員審核後才會真正刪除。'}')">
               <button type="submit" class="btn btn-sm btn-link ${locals.canDelete ? 'text-danger' : 'text-warning'} p-0" title="${locals.canDelete ? '刪除' : '申請刪除'}"><i class="bi bi-trash"></i></button>
             </form>`;
        return `
        <li class="list-group-item d-flex justify-content-between align-items-start">
          <div>
            <span class="badge bg-${(typeof activityTypeColorMap !== 'undefined' && activityTypeColorMap[a.activity_type]) || 'secondary'} me-2">${escapeHtml(a.activity_type)}</span>
            <span>${a.content.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</span>
            <div class="text-muted small mt-1">${a.activity_date} · ${escapeHtml(a.created_by) || 'system'}${a.opportunity_name ? ' · 商機：' + escapeHtml(a.opportunity_name) : ''}</div>
          </div>
          ${deleteControl}
        </li>
      `;
      }).join('') || '<li class="list-group-item text-center text-muted py-3">尚無活動紀錄</li>'}
    </ul>
  </div>
</div>

${locals.canEditCrm ? `
<div class="card">
  <div class="card-header"><i class="bi bi-gear"></i> 編輯資料</div>
  <div class="card-body">
    <form action="/customers/${customer.id}" method="POST">
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">類型</label>
          <select name="party_type" class="form-select" id="editPartyType" onchange="document.getElementById('editVendorTypeWrap').style.display = (this.value === '客戶') ? 'none' : '';">
            <option value="客戶" ${(customer.party_type || '客戶') === '客戶' ? 'selected' : ''}>客戶</option>
            <option value="廠商" ${customer.party_type === '廠商' ? 'selected' : ''}>廠商</option>
            <option value="兩者皆是" ${customer.party_type === '兩者皆是' ? 'selected' : ''}>兩者皆是（客戶+廠商）</option>
          </select>
        </div>
        <div class="col-md-4" id="editVendorTypeWrap" style="${(customer.party_type === '客戶' || !customer.party_type) ? 'display:none' : ''}">
          <label class="form-label">廠商類型</label>
          <select name="vendor_type" class="form-select">
            <option value="" ${!customer.vendor_type ? 'selected' : ''}>-- 選擇類型 --</option>
            <option value="個人" ${customer.vendor_type === '個人' ? 'selected' : ''}>個人</option>
            <option value="公司" ${customer.vendor_type === '公司' ? 'selected' : ''}>公司</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">客戶編號</label>
          <input type="text" name="customer_code" class="form-control" value="${(customer.customer_code || '').replace(/"/g, '&quot;')}" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">統一編號</label>
          <input type="text" name="tax_id" class="form-control" value="${customer.tax_id || ''}" maxlength="8">
        </div>
        <div class="col-md-4">
          <label class="form-label">公司名稱</label>
          <input type="text" name="company_name" class="form-control" value="${(customer.company_name || '').replace(/"/g, '&quot;')}" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">客戶關係負責人（使用者）</label>
          <select name="owner_salesperson_id" class="form-select">
            <option value="">-- 選擇使用者 --</option>
            ${(staffUsers || []).map(u => {
              const selected = customer.owner_salesperson_id == u.id ? 'selected' : '';
              return '<option value="' + u.id + '" ' + selected + '>' + (u.name || '').replace(/"/g, '&quot;') + '</option>';
            }).join('')}
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">聯絡人（對方窗口）</label>
          <input type="text" name="contact_name" class="form-control" value="${(customer.contact_name || '').replace(/"/g, '&quot;')}">
        </div>
        <div class="col-md-4">
          <label class="form-label">聯絡電話</label>
          <input type="text" name="contact_phone" class="form-control" value="${(customer.contact_phone || '').replace(/"/g, '&quot;')}">
        </div>
        <div class="col-md-4">
          <label class="form-label">聯絡信箱</label>
          <input type="email" name="contact_email" class="form-control" value="${(customer.contact_email || '').replace(/"/g, '&quot;')}">
        </div>
        <div class="col-md-4">
          <label class="form-label">銀行名稱</label>
          <input type="text" name="bank_name" class="form-control" value="${(customer.bank_name || '').replace(/"/g, '&quot;')}">
        </div>
        <div class="col-md-4">
          <label class="form-label">銀行帳號</label>
          <input type="text" name="bank_account" class="form-control" value="${(customer.bank_account || '').replace(/"/g, '&quot;')}">
        </div>
        <div class="col-md-8">
          <label class="form-label">地址</label>
          <input type="text" name="address" class="form-control" value="${(customer.address || '').replace(/"/g, '&quot;')}">
        </div>
        <div class="col-md-4">
          <label class="form-label">客戶等級</label>
          <select name="customer_level" class="form-select">
            <option value="" ${!customer.customer_level ? 'selected' : ''}>-- 未分級 --</option>
            ${(typeof customerLevels !== 'undefined' && customerLevels ? customerLevels : []).map(l => {
              const safeName = escapeHtml(l.level_name).replace(/"/g, '&quot;');
              const selected = customer.customer_level === l.level_name ? 'selected' : '';
              return '<option value="' + safeName + '" ' + selected + '>' + escapeHtml(l.level_name) + '</option>';
            }).join('')}
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">產業別</label>
          <input type="text" name="industry" class="form-control" value="${(customer.industry || '').replace(/"/g, '&quot;')}">
        </div>
        <div class="col-md-4">
          <label class="form-label">往來狀態</label>
          <select name="status" class="form-select">
            ${(typeof customerStatuses !== 'undefined' && customerStatuses ? customerStatuses : []).map(s => {
              const safeName = escapeHtml(s.status_name).replace(/"/g, '&quot;');
              const selected = customer.status === s.status_name ? 'selected' : '';
              return '<option value="' + safeName + '" ' + selected + '>' + escapeHtml(s.status_name) + '</option>';
            }).join('')}
          </select>
        </div>
        <div class="col-12">
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> 更新</button>
        </div>
      </div>
    </form>
    <hr>
    <form action="/customers/${customer.id}/delete" method="POST" onsubmit="return confirm('${locals.canDelete ? '確定要刪除此客戶/廠商？相關的專案、銷售機會、活動紀錄不會被刪除，仍會保留原有紀錄。' : '確定要送出刪除申請嗎？將由管理員審核後才會真正刪除。'}')">
      <button type="submit" class="btn btn-outline-${locals.canDelete ? 'danger' : 'warning'} btn-sm">
        <i class="bi bi-trash"></i> ${locals.canDelete ? '刪除此客戶/廠商' : '申請刪除此客戶/廠商'}
      </button>
    </form>
  </div>
</div>
` : ''}

${locals.canEditCrm ? `
<!-- 新增轉介紹 Modal -->
<div class="modal fade" id="addReferralModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/referral-rewards" method="POST">
        <input type="hidden" name="referring_customer_id" value="${customer.id}">
        <div class="modal-header">
          <h5 class="modal-title">新增轉介紹紀錄</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">被介紹客戶</label>
            <select name="referred_customer_id" id="referredCustomerSelect" class="form-select select2-dropdown">
              <option value="">-- 尚未成立/不指定 --</option>
              ${(allCustomers || []).filter(c => c.id !== customer.id).map(c => {
                const companyName = (c.company_name || '').replace(/"/g, '&quot;');
                const customerCode = (c.customer_code || '').replace(/"/g, '&quot;');
                return '<option value="' + c.id + '">' + companyName + ' (' + customerCode + ')</option>';
              }).join('')}
            </select>
            ${canCreateCustomerDirectly ? '<small class="form-text text-muted">找不到客戶？<a href="#" id="quickAddReferredCustomerLink" class="text-primary">快速新增</a></small>' : ''}
          </div>
          <div class="mb-3">
            <label class="form-label">受益對象</label>
            <select name="recipient_type" class="form-select referral-recipient-type">
              <option value="customer" selected>客戶本人（${escapeHtml(customer.company_name)}）</option>
              <option value="staff">指定員工</option>
            </select>
          </div>
          <div class="mb-3 referral-recipient-user d-none">
            <label class="form-label">員工</label>
            <select name="recipient_user_id" class="form-select select2-dropdown">
              <option value="">-- 選擇員工 --</option>
              ${(staffUsers || []).map(u => '<option value="' + u.id + '">' + (u.name || '').replace(/"/g, '&quot;') + '</option>').join('')}
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">獎勵金額</label>
            <input type="number" name="reward_amount" class="form-control" step="1" min="0" value="0">
          </div>
          <div class="mb-3">
            <label class="form-label">備註</label>
            <textarea name="notes" class="form-control" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
          <button type="submit" class="btn btn-primary">新增</button>
        </div>
      </form>
    </div>
  </div>
</div>

${canCreateCustomerDirectly ? `
<!-- 快速新增客戶 Modal（供「新增轉介紹紀錄」的被介紹客戶欄位使用） -->
<div class="modal fade" id="quickAddReferredCustomerModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          <i class="bi bi-building-add"></i> 快速新增客戶
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="quickAddReferredCustomerForm">
          <div class="mb-3">
            <label class="form-label">客戶編號 <span class="text-danger">*</span></label>
            <input type="text" name="customer_code" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">公司名稱 <span class="text-danger">*</span></label>
            <input type="text" name="company_name" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">統一編號</label>
            <input type="text" name="tax_id" class="form-control" maxlength="8" pattern="[0-9]{8}">
            <small class="form-text text-muted">8 位數字</small>
          </div>
        </form>
        <div id="quickAddReferredCustomerError" class="alert alert-danger d-none"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          <i class="bi bi-x-lg"></i> 取消
        </button>
        <button type="button" class="btn btn-primary" id="quickAddReferredCustomerSubmit">
          <i class="bi bi-check-lg"></i> 新增並選擇
        </button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const quickAddLink = document.getElementById('quickAddReferredCustomerLink');
  if (!quickAddLink) return;

  const quickAddModal = new bootstrap.Modal(document.getElementById('quickAddReferredCustomerModal'));
  const quickAddForm = document.getElementById('quickAddReferredCustomerForm');
  const quickAddSubmit = document.getElementById('quickAddReferredCustomerSubmit');
  const quickAddError = document.getElementById('quickAddReferredCustomerError');

  quickAddLink.addEventListener('click', function(e) {
    e.preventDefault();
    quickAddForm.reset();
    quickAddError.classList.add('d-none');
    quickAddModal.show();
  });

  quickAddSubmit.addEventListener('click', async function() {
    const formData = new FormData(quickAddForm);

    if (!formData.get('customer_code') || !formData.get('company_name')) {
      quickAddError.textContent = '請填寫客戶編號和公司名稱';
      quickAddError.classList.remove('d-none');
      return;
    }

    quickAddSubmit.disabled = true;
    quickAddSubmit.innerHTML = '<span class="spinner-border spinner-border-sm"></span> 新增中...';
    quickAddError.classList.add('d-none');

    try {
      const response = await fetch('/customers/quick-add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customer_code: formData.get('customer_code'),
          company_name: formData.get('company_name'),
          tax_id: formData.get('tax_id') || ''
        })
      });
      const result = await response.json();

      if (result.success) {
        const c = result.customer;
        const displayText = c.company_name + ' (' + c.customer_code + ')';
        const newOption = new Option(displayText, c.id, true, true);
        $('#referredCustomerSelect').append(newOption).trigger('change');

        quickAddModal.hide();
        if (typeof showToast === 'function') {
          showToast('客戶新增成功：' + c.company_name, 'success');
        }
      } else {
        quickAddError.textContent = result.error || '新增客戶失敗';
        quickAddError.classList.remove('d-none');
      }
    } catch (error) {
      console.error('快速新增客戶錯誤:', error);
      quickAddError.textContent = '新增客戶時發生錯誤：' + error.message;
      quickAddError.classList.remove('d-none');
    } finally {
      quickAddSubmit.disabled = false;
      quickAddSubmit.innerHTML = '<i class="bi bi-check-lg"></i> 新增並選擇';
    }
  });
});
</script>
` : ''}

