<%- include('../layout', { title: title, body: `
<div class="row justify-content-center">
  <div class="col-lg-7">
    <h1 class="h3 mb-3"><i class="bi bi-life-preserver"></i> ${firstTime ? '雙因素驗證已啟用' : '新的復原碼'}</h1>

    <div class="alert alert-warning">
      <i class="bi bi-exclamation-triangle"></i> <strong>請現在就把這些復原碼存放在安全的地方</strong>（例如密碼管理員或列印後放在保險櫃）。
      手機遺失或無法使用驗證器時，可以用復原碼登入；<strong>每組只能使用一次，而且關閉這個頁面後就不會再顯示</strong>。
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-2" id="codes">
          ${codes.map(c => '<div class="col-6"><code class="fs-5 user-select-all">' + escapeHtml(c) + '</code></div>').join('')}
        </div>
      </div>
    </div>

    <div class="d-flex gap-2">
      <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> 列印</button>
      <a href="/account/security" class="btn btn-dark">我已存好，繼續</a>
    </div>
  </div>
</div>
` }) %>
