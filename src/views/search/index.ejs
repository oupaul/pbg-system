<%
  function escapeHtml(str) {
    return (str === null || str === undefined ? '' : String(str))
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  // 先跳脫再標示關鍵字，避免資料內容被當成 HTML
  function highlight(text, keyword) {
    const safe = escapeHtml(text);
    if (!keyword) return safe;
    const safeKeyword = escapeHtml(keyword).replace(/[.*+?^$()|[\]\\{}]/g, '\\$&');
    return safe.replace(new RegExp('(' + safeKeyword + ')', 'gi'), '<mark>$1</mark>');
  }
  function renderHits(hits, keyword) {
    return hits.map(function (h) {
      return h.matched.map(function (m) {
        return '<div class="small"><span class="badge bg-light text-dark border">' + escapeHtml(h.tableLabel) + '・' + escapeHtml(m.columnLabel) + '</span> '
          + (m.snippet === null ? '<span class="text-muted">（內容不顯示）</span>' : highlight(m.snippet, keyword)) + '</div>';
      }).join('');
    }).join('');
  }
%>
<%- include('../layout', { body: `
<div class="row mb-4">
  <div class="col">
    <h1 class="h3"><i class="bi bi-search"></i> 全域搜尋</h1>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form method="get" action="/search" class="d-flex gap-2">
      <div class="flex-grow-1">
        <input type="text" name="q" class="form-control form-control-lg" placeholder="搜尋專案、客戶、發票、收款、成本、備註等任何資料..." value="${escapeHtml(typeof q !== 'undefined' ? q : '')}" autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-lg">
        <i class="bi bi-search"></i> 搜尋
      </button>
    </form>
  </div>
</div>

${typeof message !== 'undefined' && message ? `
<div class="alert alert-info">
  <i class="bi bi-info-circle"></i> ${escapeHtml(message)}
</div>
` : ''}

${typeof results !== 'undefined' && results ? `
<div class="row g-4">
  ${results.projects.length > 0 ? `
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <i class="bi bi-folder"></i> 專案 (${results.totals.projects}${results.totals.projects > results.projects.length ? '，僅顯示前 ' + results.projects.length + ' 筆' : ''})
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr><th>專案</th><th>類型</th><th>客戶</th><th>業務</th><th class="text-end">金額</th><th>狀態</th><th>命中內容</th><th></th></tr>
          </thead>
          <tbody>
            ${results.projects.map(p => {
              const tc = typeof typeColorMap !== 'undefined' && typeColorMap[p.project_type] ? typeColorMap[p.project_type] : 'info';
              return '<tr><td><code>' + escapeHtml(p.project_code) + '</code><div>' + escapeHtml(p.project_name) + '</div></td>'
                + '<td><span class="badge bg-' + escapeHtml(tc) + '">' + escapeHtml(p.project_type || '-') + '</span></td>'
                + '<td>' + escapeHtml(p.company_name || '-') + '</td>'
                + '<td>' + escapeHtml(p.salesperson_name || '-') + '</td>'
                + '<td class="text-end">' + (typeof currencySymbol !== 'undefined' ? escapeHtml(currencySymbol) : '$') + (p.price_with_tax || 0).toLocaleString() + '</td>'
                + '<td><span class="badge bg-' + (p.status === '已結案' ? 'secondary' : 'warning') + '">' + escapeHtml(p.status || '-') + '</span></td>'
                + '<td>' + renderHits(p.hits, q) + '</td>'
                + '<td><a href="/projects/' + p.id + '" class="btn btn-sm btn-outline-primary">查看</a></td></tr>';
            }).join('')}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  ` : ''}

  ${results.customers.length > 0 ? `
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <i class="bi bi-building"></i> 客戶/廠商 (${results.totals.customers}${results.totals.customers > results.customers.length ? '，僅顯示前 ' + results.customers.length + ' 筆' : ''})
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr><th>客戶編號</th><th>公司名稱</th><th>統編</th><th>命中內容</th><th></th></tr>
          </thead>
          <tbody>
            ${results.customers.map(c =>
              '<tr><td><code>' + escapeHtml(c.customer_code) + '</code></td><td>' + escapeHtml(c.company_name) + '</td><td>' + escapeHtml(c.tax_id || '-') + '</td>'
              + '<td>' + renderHits(c.hits, q) + '</td>'
              + '<td><a href="/customers/' + c.id + '" class="btn btn-sm btn-outline-primary">查看</a></td></tr>'
            ).join('')}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  ` : ''}

  ${results.other.length > 0 ? `
  <div class="col-12">
    <div class="card border-warning">
      <div class="card-header"><i class="bi bi-shield-exclamation"></i> 未歸屬到專案或客戶的資料（僅管理者可見，不顯示內容）</div>
      <ul class="list-group list-group-flush">
        ${results.other.map(o => '<li class="list-group-item">' + escapeHtml(o.tableLabel) + '：' + o.hits.length + ' 筆命中（' + escapeHtml([...new Set(o.hits.flatMap(h => h.matched.map(m => m.columnLabel)))].join('、')) + '）</li>').join('')}
      </ul>
    </div>
  </div>
  ` : ''}

  ${results.projects.length === 0 && results.customers.length === 0 && results.other.length === 0 ? `
  <div class="col-12">
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> 找不到符合「${escapeHtml(q)}」的資料</div>
  </div>
  ` : ''}
</div>
` : ''}
` }) %>
