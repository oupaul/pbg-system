# ============================================================
# 環境變數範例檔案
#
# 本專案未安裝 dotenv，.env 不會被自動載入。此檔案僅作為文件／
# 範本用途，實際使用時需自行 export 或交由行程管理工具
# （systemd/pm2 等）注入環境變數。
#
# 透過 setup.sh / deploy.sh 部署的正式環境不需要手動設定這個檔
# 案：deploy.sh 會在首次安裝時自動產生 SESSION_SECRET 並寫入
# systemd unit。以下主要給 `npm run dev` / 手動啟動時參考。
# ============================================================

# 伺服器監聽埠號（預設 3000）
PORT=3000

# 執行環境：development｜production
NODE_ENV=development

# Session 簽章密鑰。留空的話，src/app.js 每次啟動會自動產生一組
# 亂數金鑰，代表每次重啟服務都會讓所有人被登出；正式環境務必固定
# 此值（deploy.sh 會自動處理，見上方說明）。
# 產生方式：openssl rand -hex 32
SESSION_SECRET=

# SQLite 資料庫檔案路徑。注意：這個變數只影響 migrations/ 與
# scripts/ 底下的獨立腳本；主程式 src/models/db.js 目前寫死使用
# data/invoice_bonus.db，不會讀取此變數。
# DB_PATH=./data/invoice_bonus.db
